programa
{
	
	funcao inicio()
	{
	real num, dobro, ter
		escreva("Digite um número: ")
		leia(num)

		dobro = num * 2
		ter = num / 3
		escreva("O dobro de ", num, " é ", dobro)
		escreva("\nA terça parte de ", num, " é ", ter)
	}
}
