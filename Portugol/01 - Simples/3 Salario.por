programa
{
	
	funcao inicio()
	{
	cadeia nome
	real salario
	
		escreva("Digite o nome do(a) funcionário(a): ")
		leia(nome)
		escreva("Digite o salário: ")
		leia(salario)

		escreva("O(a) funcionário(a) ", nome," tem um salário de R$: ", salario, " em Junho")

	}
}
