programa
{
	
	funcao inicio()
	{
	real largura, altura, area, qtd

		escreva("Digite a largura: ")
		leia(largura)
		escreva("Digite a altura: ")
		leia(altura)

		area = largura * altura
		qtd = area / 2
		escreva("Área a ser pintada: ", area, " metros")
		escreva("\nA quantidade de tinta necesária para pintar: ", qtd, " Litros")
	}
}
