programa
{
	funcao inicio()
	{
	real km, prec
	inteiro dias
	
		escreva("Km percorrido: ")
		leia(km)
		escreva("Quantidade de dias do aluguel: ")
		leia(dias)

		prec = (dia*90) + (km*0.2)
		escreva("O preço total a pagar foi de: ", prec, " Reais")
	}
}
