programa
{
	funcao inicio()
	{
	
	real salario, nvsalario
	
		escreva("Digite o salário antigo: ")
		leia(salario)

		nvsalario = salario + (salario * 0.15)
		escreva("Novo salário: ", nvsalario, " Reais")
	}
}
