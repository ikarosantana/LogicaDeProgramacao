programa
{
	
	funcao inicio()
	{
	real reais, dolares
	
		escreva("Quanto reais você tem: ")
		leia(reais)

		dolares = reais / 3.45

		escreva("Você pode comprar: ", dolares, " dolares")
		
	}
}
