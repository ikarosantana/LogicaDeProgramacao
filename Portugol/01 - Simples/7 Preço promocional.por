programa
{
	funcao inicio()
	{
	real v1, v2
	
		escreva("Valor do produto: ")
		leia(v1)

		v2 = v1 - (v1 * 0.05)
		escreva("O VALOR PROMOCIONAL do Produto: ", v2, " reais")
	}
}
